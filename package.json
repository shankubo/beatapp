{
  "name": "beatapp",
  "private": true,
  "version": "0.1.8",
  "type": "module",
  "description": "PWA mobile-first pour creer des reels Instagram / WhatsApp, 100% cote client",
  "scripts": {
    "dev": "vite",
    "dev:lan": "vite --host",
    "build": "tsc -b && vite build",
    "version:bump": "node scripts/bump-version.mjs",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:browser": "vitest run --project browser",
    "i18n:check": "tsx scripts/i18n-check.ts",
    "steps:images": "node scripts/generate-step-images.mjs"
  },
  "dependencies": {
    "@use-gesture/react": "10.3.1",
    "i18next": "26.3.6",
    "i18next-browser-languagedetector": "8.2.1",
    "idb": "8.0.3",
    "immer": "11.1.15",
    "mediabunny": "1.51.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-i18next": "17.0.11",
    "zundo": "2.3.0",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.1.1",
    "@types/react": "19.2.8",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "@vitest/browser": "4.1.10",
    "@vitest/browser-playwright": "^4.1.10",
    "eslint": "9.39.5",
    "eslint-plugin-i18next": "6.1.5",
    "eslint-plugin-react-hooks": "7.0.1",
    "fast-check": "4.9.0",
    "globals": "17.7.0",
    "playwright": "1.62.0",
    "sharp": "^0.35.3",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.1.5",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "4.1.10"
  }
}
